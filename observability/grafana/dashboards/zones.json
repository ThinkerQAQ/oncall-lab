{
  "uid": "oncall-zones",
  "title": "Oncall Lab · Logical Zones (Synthetic)",
  "schemaVersion": 40,
  "version": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "tags": [
    "synthetic",
    "logical-zones",
    "kitex"
  ],
  "description": "Zone labels map to actual Docker Compose containers on one Docker host, not physical availability zones.",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Gateway RPC QPS by logical zone",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (zone) (rate(rpc_client_requests_total{zone=~\"zone-.*\"}[30s]))",
          "legendFormat": "{{zone}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Kitex RPC timeout QPS by zone",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (zone) (rate(rpc_client_requests_total{zone=~\"zone-.*\",result=\"timeout\"}[30s]))",
          "legendFormat": "{{zone}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Timeout QPS by actual Gateway instance",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (zone,instance) (rate(rpc_client_requests_total{zone=~\"zone-.*\",result=\"timeout\"}[30s]))",
          "legendFormat": "{{zone}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Timeout ratio by zone",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(zone)(rate(rpc_client_requests_total{zone=~\"zone-.*\",result=\"timeout\"}[30s])) / clamp_min(sum by(zone)(rate(rpc_client_requests_total{zone=~\"zone-.*\"}[30s])), 0.000001)",
          "legendFormat": "{{zone}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Kitex native client throughput by zone and framework status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (zone,status) (rate(kitex_client_throughput{zone=~\"zone-.*\"}[30s]))",
          "legendFormat": "{{zone}} / {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Kitex server requests by zone",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (zone) (rate(rpc_server_requests_total{zone=~\"zone-.*\"}[30s]))",
          "legendFormat": "{{zone}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Client RPC p95 (estimated) by zone",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,zone)(rate(rpc_client_duration_seconds_bucket{zone=~\"zone-.*\"}[30s])))",
          "legendFormat": "{{zone}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Prometheus target status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{zone=~\"zone-.*\"}",
          "legendFormat": "{{job}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
