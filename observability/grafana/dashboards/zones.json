{
  "uid": "oncall-zones",
  "title": "Oncall Lab · Logical Zones (Synthetic)",
  "schemaVersion": 40,
  "version": 4,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "tags": [
    "synthetic",
    "logical-zones",
    "kitex"
  ],
  "description": "Zone labels map to actual Docker Compose containers on one Docker host, not physical availability zones.",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Gateway RPC QPS by logical zone",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (zone) (rate(rpc_client_requests_total{zone=~\"zone-.*\"}[30s]))",
          "legendFormat": "{{zone}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Kitex RPC timeout QPS by zone",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (zone) (rate(rpc_client_requests_total{zone=~\"zone-.*\",result=\"timeout\"}[30s]))",
          "legendFormat": "{{zone}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Timeout QPS by actual Gateway instance",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (zone,instance) (rate(rpc_client_requests_total{zone=~\"zone-.*\",result=\"timeout\"}[30s]))",
          "legendFormat": "{{zone}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Timeout ratio by zone",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(zone)(rate(rpc_client_requests_total{zone=~\"zone-.*\",result=\"timeout\"}[30s])) / clamp_min(sum by(zone)(rate(rpc_client_requests_total{zone=~\"zone-.*\"}[30s])), 0.000001)",
          "legendFormat": "{{zone}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Kitex native client throughput by zone and framework status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (zone,status) (rate(kitex_client_throughput{zone=~\"zone-.*\"}[30s]))",
          "legendFormat": "{{zone}} / {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Kitex server requests by actual Metadata instance",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (zone, instance) (rate(rpc_server_requests_total{zone=~\"zone-.*\"}[30s]))",
          "legendFormat": "{{zone}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Client RPC p95 (estimated) by zone",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,zone)(rate(rpc_client_duration_seconds_bucket{zone=~\"zone-.*\"}[30s])))",
          "legendFormat": "{{zone}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Gateway and Metadata Prometheus target status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{zone=~\"zone-.*\"}",
          "legendFormat": "{{job}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Kitex Client Timeout Logs (Loki)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"oncall-lab\",result=\"timeout\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Kitex Metadata Application Errors",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"oncall-lab\",result=\"application_error\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Actual Grafana Alert State Transitions (Loki)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{from=\"state-history\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Real Kitex RPC failure QPS by synthetic error code",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 60
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (zone, error_code) (rate(rpc_client_requests_total{zone=~\"zone-.*\",result!=\"success\"}[30s]))",
          "legendFormat": "{{zone}} / {{error_code}}"
        }
      ]
    }
  ]
}
