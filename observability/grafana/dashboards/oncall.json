{
  "uid": "oncall-lab",
  "title": "Oncall Lab · Kitex RPC Baseline",
  "schemaVersion": 40,
  "version": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "tags": [
    "synthetic",
    "kitex"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Kitex client RPC requests per second",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(rpc_client_requests_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Kitex RPC duration p95 (s)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rpc_client_duration_seconds_bucket[1m])))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
